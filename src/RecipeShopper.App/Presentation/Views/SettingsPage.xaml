<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RecipeShopper.App.Presentation.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RecipeShopper.App.Presentation.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,28" Spacing="12">
            <VerticalStackLayout Spacing="1">
                <Label Style="{StaticResource PageTitle}" Text="Postavke" />
                <Label Style="{StaticResource Caption}" Text="Izgled, kupovina, plan i podaci" />
            </VerticalStackLayout>

            <Label Style="{StaticResource SectionTitle}" Text="Izgled" />
            <Border><Grid ColumnDefinitions="*,*"><Label Text="Tema" VerticalOptions="Center" /><Picker Grid.Column="1" ItemsSource="{Binding AppearanceOptions}" SelectedItem="{Binding SelectedAppearance}" /></Grid></Border>
            <Border><Grid ColumnDefinitions="*,*"><Label Text="Akcent" VerticalOptions="Center" /><Picker Grid.Column="1" ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding SelectedAccent}" /></Grid></Border>

            <Label Style="{StaticResource SectionTitle}" Text="Kupovina" />
            <Border><Grid ColumnDefinitions="*,*"><Label Text="Početno grupiranje" VerticalOptions="Center" /><Picker Grid.Column="1" ItemsSource="{Binding GroupingOptions}" SelectedItem="{Binding DefaultGrouping}" /></Grid></Border>
            <Border><Grid ColumnDefinitions="*,Auto"><Label Text="Označeno pomjeri na dno" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding MoveCheckedToBottom}" /></Grid></Border>
            <Border><Grid ColumnDefinitions="*,Auto"><Label Text="Sakrij označene stavke" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding HideChecked}" /></Grid></Border>
            <Border><Grid ColumnDefinitions="*,Auto"><Label Text="Potvrdi brisanje" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding ConfirmDestructiveActions}" /></Grid></Border>

            <Label Style="{StaticResource SectionTitle}" Text="Plan obroka" />
            <Border><Grid ColumnDefinitions="*,Auto"><Label Text="Referentni ponedjeljak (A)" VerticalOptions="Center" /><DatePicker Grid.Column="1" Date="{Binding ReferenceMonday}" /></Grid></Border>
            <Border><Grid ColumnDefinitions="*,Auto"><Label Text="Dnevni podsjetnik" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding ReminderEnabled}" /></Grid></Border>
            <Border><Grid ColumnDefinitions="*,Auto"><Label Text="Vrijeme podsjetnika" VerticalOptions="Center" /><TimePicker Grid.Column="1" Time="{Binding ReminderTime}" /></Grid></Border>

            <Label Style="{StaticResource SectionTitle}" Text="Katalozi i regija" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Command="{Binding ManageCategoriesCommand}" Style="{StaticResource SecondaryButton}" Text="Kategorije" />
                <Button Grid.Column="1" Command="{Binding ManageStoresCommand}" Style="{StaticResource SecondaryButton}" Text="Trgovine" />
            </Grid>
            <Border><Grid ColumnDefinitions="*,*"><Label Text="Valuta" VerticalOptions="Center" /><Picker Grid.Column="1" ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding Currency}" /></Grid></Border>

            <Label Style="{StaticResource SectionTitle}" Text="Zajednički prostor" />
            <Border IsVisible="{Binding IsWorkspaceConnected}">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource Caption}" Text="Svi uređaji sa ovim kodom vide iste podatke." />
                    <Label FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" Text="{Binding ShareCode}" />
                    <Label HorizontalTextAlignment="Center" Style="{StaticResource Caption}" Text="{Binding SyncStatusText}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Command="{Binding ShareWorkspaceCodeCommand}" Style="{StaticResource SecondaryButton}" Text="Podijeli kod" />
                        <Button Grid.Column="1" Command="{Binding SyncNowCommand}" Text="Sinhronizuj" />
                    </Grid>
                    <Button Command="{Binding LeaveWorkspaceCommand}" Style="{StaticResource DangerButton}" Text="Napusti prostor" />
                </VerticalStackLayout>
            </Border>
            <Border IsVisible="{Binding IsWorkspaceConnected, Converter={StaticResource InverseBoolConverter}}">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource Caption}" Text="Kreirajte novi prostor ili unesite kod koji ste dobili." />
                    <Entry MaxLength="9" Placeholder="ABCD-1234" Text="{Binding ShareCodeInput}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Command="{Binding CreateWorkspaceCommand}" IsEnabled="{Binding IsSyncConfigured}" Style="{StaticResource SecondaryButton}" Text="Kreiraj" />
                        <Button Grid.Column="1" Command="{Binding JoinWorkspaceCommand}" IsEnabled="{Binding IsSyncConfigured}" Text="Pridruži se" />
                    </Grid>
                    <Label HorizontalTextAlignment="Center" Style="{StaticResource Caption}" Text="{Binding SyncStatusText}" />
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource SectionTitle}" Text="Podaci" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Command="{Binding ImportCommand}" Style="{StaticResource SecondaryButton}" Text="Uvezi JSON" />
                <Button Grid.Column="1" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" Text="Izvezi JSON" />
            </Grid>
            <Button Command="{Binding ResetCommand}" Style="{StaticResource DangerButton}" Text="Vrati početne podatke" />

            <Border>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label FontFamily="OpenSansSemibold" Text="{Binding VersionText}" />
                    <Label Style="{StaticResource Caption}" Text="Offline recepti, plan obroka i pametna kupovina" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
