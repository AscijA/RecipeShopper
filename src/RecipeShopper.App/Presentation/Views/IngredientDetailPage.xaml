<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RecipeShopper.App.Presentation.Views.IngredientDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:RecipeShopper.App.Presentation.Models"
    xmlns:vm="clr-namespace:RecipeShopper.App.Presentation.ViewModels"
    x:DataType="vm:IngredientDetailViewModel"
    Title="{Binding Title}">
    <ContentPage.ToolbarItems><ToolbarItem Command="{Binding EditCommand}" Text="Uredi" /></ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Border StrokeThickness="0">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Label FontSize="62" HorizontalOptions="Center" IsVisible="{Binding Ingredient.HasImage, Converter={StaticResource InverseBoolConverter}}" Text="{Binding Ingredient.Icon}" />
                    <Image Aspect="AspectFill" HeightRequest="140" IsVisible="{Binding Ingredient.HasImage}" Source="{Binding Ingredient.ImagePreviewPath}" WidthRequest="140" />
                    <Label Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center" Text="{Binding Ingredient.Name}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding Ingredient.MeasurementDescription}" />
                </VerticalStackLayout>
            </Border>
            <Label Style="{StaticResource SectionTitle}" Text="Pakovanja i cijene" />
            <Label IsVisible="{Binding Offers.Count, Converter={StaticResource ZeroToTrueConverter}}" Style="{StaticResource Caption}" Text="Još nema definisanih ponuda." />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Offers}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:PackageOfferItem">
                        <Border>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label FontFamily="OpenSansSemibold" Text="{Binding Store}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Description}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding UpdatedAt, StringFormat='Ažurirano {0:d}'}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" FontFamily="OpenSansSemibold" Text="{Binding PriceText}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Text="Arhiviraj namirnicu" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
