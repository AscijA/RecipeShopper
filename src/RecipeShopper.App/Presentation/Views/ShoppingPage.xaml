<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RecipeShopper.App.Presentation.Views.ShoppingPage"
    x:Name="ShoppingRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:RecipeShopper.App.Presentation.Models"
    xmlns:vm="clr-namespace:RecipeShopper.App.Presentation.ViewModels"
    x:DataType="vm:ShoppingViewModel"
    Shell.NavBarIsVisible="False">
    <Grid Padding="20,18,20,10" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="1">
                <Label Style="{StaticResource PageTitle}" Text="Kupovina" />
                <Label Style="{StaticResource Caption}" Text="{Binding UncheckedCount, StringFormat='{0} neoznačenih stavki'}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Command="{Binding AddManualCommand}" Style="{StaticResource SecondaryButton}" Text="+ Namirnica" />
            <Button Grid.Column="2" Command="{Binding ManageListsCommand}" Style="{StaticResource GhostButton}" Text="Liste" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Border Padding="8,0"><Picker ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding ActiveLists}" SelectedItem="{Binding SelectedList}" Title="Lista" /></Border>
            <Border Grid.Column="1" Padding="8,0"><Picker ItemsSource="{Binding GroupingOptions}" SelectedItem="{Binding SelectedGrouping}" Title="Grupiranje" /></Border>
        </Grid>
        <Border Grid.Row="2" BackgroundColor="{Binding TotalColor}" StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout>
                    <Label FontFamily="OpenSansSemibold" Text="{Binding TotalText}" TextColor="White" />
                    <Label FontSize="11" Text="Zeleno znači da sve neoznačene stavke imaju dovoljna pakovanja i cijene." TextColor="White" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Command="{Binding ShareCommand}" BackgroundColor="#33FFFFFF" Text="Podijeli" />
            </Grid>
        </Border>
        <CollectionView Grid.Row="3" IsGrouped="True" ItemsSource="{Binding Groups}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Margin="20,70" HorizontalOptions="Center" Spacing="8">
                    <Label FontSize="44" HorizontalTextAlignment="Center" Text="🛒" />
                    <Label Style="{StaticResource SectionTitle}" Text="Lista je prazna" />
                    <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Text="Dodajte recept ili pojedinačnu namirnicu." />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:ShoppingGroup">
                    <Label Margin="2,12,2,7" FontFamily="OpenSansSemibold" FontSize="16" Text="{Binding Name}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ShoppingListItem">
                    <Border Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                            <CheckBox CheckedChanged="OnItemCheckedChanged" IsChecked="{Binding IsChecked}" />
                            <Label Grid.Column="1" FontSize="23" Text="{Binding Icon}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label FontFamily="OpenSansSemibold" Text="{Binding Name}" />
                                <Label Text="{Binding QuantityText}" />
                                <Label Style="{StaticResource Caption}" Text="{Binding SourceSummary}" />
                                <Label Style="{StaticResource Caption}" Text="{Binding PriceText}" />
                                <Label FontSize="12" IsVisible="{Binding Recommendation, Converter={StaticResource StringNotEmptyConverter}}" Text="{Binding Recommendation}" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" Spacing="2">
                                <Button Command="{Binding Source={x:Reference ShoppingRoot}, Path=BindingContext.SelectPackageCommand}" CommandParameter="{Binding .}" Style="{StaticResource GhostButton}" Text="Pakovanje" />
                                <Button Command="{Binding Source={x:Reference ShoppingRoot}, Path=BindingContext.RemoveCommand}" CommandParameter="{Binding .}" Style="{StaticResource GhostButton}" Text="Ukloni" TextColor="{StaticResource Danger}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="4" Command="{Binding ClearCommand}" Style="{StaticResource DangerButton}" Text="Očisti listu" />
    </Grid>
</ContentPage>
