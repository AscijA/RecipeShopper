<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RecipeShopper.App.Presentation.Views.MealPlannerPage"
    x:Name="PlannerRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:RecipeShopper.App.Presentation.Models"
    xmlns:vm="clr-namespace:RecipeShopper.App.Presentation.ViewModels"
    x:DataType="vm:MealPlannerViewModel"
    Title="Plan obroka">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <Border Padding="4">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                <Button Command="{Binding ShowWeekACommand}" Text="Sedmica A" />
                <Button Grid.Column="1" Command="{Binding ShowWeekBCommand}" Style="{StaticResource SecondaryButton}" Text="Sedmica B" />
            </Grid>
        </Border>
        <Border Grid.Row="1">
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionTitle}" Text="Dodaj obrok" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Picker ItemDisplayBinding="{Binding DayName}" ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}" Title="Dan" />
                    <Picker Grid.Column="1" ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding SelectedDay.Slots}" SelectedItem="{Binding SelectedSlot}" Title="Termin" />
                </Grid>
                <Grid ColumnDefinitions="*,75,Auto" ColumnSpacing="8">
                    <Picker ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" Title="Recept" />
                    <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="×1" Text="{Binding MultiplierText}" />
                    <Button Grid.Column="2" Command="{Binding AddEntryCommand}" Text="Dodaj" />
                </Grid>
            </VerticalStackLayout>
        </Border>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Days}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DayMealPlan">
                    <Border Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource SectionTitle}" Text="{Binding DayName}" />
                                <Button Grid.Column="1" Command="{Binding Source={x:Reference PlannerRoot}, Path=BindingContext.AddDayToShoppingCommand}" CommandParameter="{Binding .}" Style="{StaticResource GhostButton}" Text="U kupovinu" />
                            </Grid>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Slots}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:MealSlotPlan">
                                        <Grid ColumnDefinitions="95,*" ColumnSpacing="8">
                                            <Label Style="{StaticResource Caption}" Text="{Binding Name}" />
                                            <VerticalStackLayout Grid.Column="1" BindableLayout.ItemsSource="{Binding Entries}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="models:MealPlanEntry">
                                                        <Label Text="{Binding DisplayText, StringFormat='• {0}'}" />
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="3" Command="{Binding AddWeekToShoppingCommand}" Text="Dodaj cijelu sedmicu u kupovinu" />
    </Grid>
</ContentPage>
